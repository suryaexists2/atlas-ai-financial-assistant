# --- App ---
APP_NAME=Atlas
APP_ENV=dev
DEBUG=false
LOG_LEVEL=INFO

# --- Database ---
# Local dev (no Postgres required):
DATABASE_URL=sqlite+aiosqlite:///./atlas_dev.db
# Production (Supabase/Neon):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Inbound secret for validating webhook updates
TELEGRAM_WEBHOOK_SECRET=
# Public base URL where the webhook is registered (e.g. https://atlas.onrender.com)
PUBLIC_BASE_URL=

# --- AI / LLM (OpenRouter-first, provider-agnostic) ---
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Model served via OpenRouter (must support tool calling)
LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# JSON list of models tried in order if the primary route fails (e.g. 404/model
# unsupported). Leave empty to strictly use LLM_MODEL. Auth errors (401/403) never rotate.
LLM_FALLBACK_MODELS=["openai/gpt-4o-mini","google/gemini-2.0-flash","meta-llama/llama-3.1-8b-instruct"]
LLM_MAX_TOKENS=600
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Optional direct providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDINGS_PROVIDER=openai

# --- Agent Core ---
# Agent replies instead of dev echo when false
ECHO_MODE=true
AGENT_MAX_TOOL_ROUNDS=5
AGENT_CONTEXT_MAX_MESSAGES=24
AGENT_FALLBACK_REPLY=Sorry — I hit a temporary hiccup. Give me a moment and try again.

# --- Financial data ---
SEC_USER_AGENT=AtlasHackathon example@example.com
FINNHUB_API_KEY=

# --- Google OAuth connectors (Gmail / Calendar / Drive) ---
# Google Cloud "Web application" OAuth client. Redirect URI must be added as:
# <PUBLIC_BASE_URL>/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Proactive scheduler ---
# How often the scheduler pool checks due jobs (briefings, alerts, reminders)
SCHEDULER_POLL_INTERVAL_SECONDS=15
SCHEDULER_MISFIRE_GRACE_SECONDS=60

# --- Media ingestion ---
# Max text excerpt kept per chunk, and max accepted file size in bytes
INGESTION_MAX_CHARS=200000
INGESTION_CHUNK_CHARS=12000
INGESTION_EXCERPT_CHARS=300
FILE_MAX_BYTES=15728640
# OpenRouter STT / vision models used for voice notes and image OCR
STT_MODEL=openai/whisper-large-v3
VISION_MODEL=openai/gpt-4o-mini
STT_TIMEOUT_SECONDS=120
VISION_TIMEOUT_SECONDS=120

# --- Telegram outbox worker ---
OUTBOX_POLL_INTERVAL_SECONDS=2.0
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_SECONDS=2.0
OUTBOX_RETRY_MAX_SECONDS=120.0
TELEGRAM_RATE_LIMIT_GLOBAL_PER_SEC=20
TELEGRAM_RATE_LIMIT_PER_CHAT_PER_SEC=1
TELEGRAM_RATE_LIMIT_BURST=5